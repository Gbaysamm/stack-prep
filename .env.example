# Copy to .env and adjust. Never commit .env.

APP_ENV=local
LOG_LEVEL=info

# Local cluster started by database/local-db.sh (trust auth, no password).
DATABASE_URL=postgresql+asyncpg://teslimsulaiman@127.0.0.1:55439/scorepilot
DATABASE_SCHEMA=stackprep

REDIS_URL=redis://127.0.0.1:6379/0

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AI help (ADR-0009). The explanations are stored and played from the database; the model only
# answers what a student asks at the board, so the efficient current model is used. It must
# still stay inside the reviewed solution and not reveal an answer early — unmeasured on Luna,
# so if it gives answers away, use gpt-6-sol. AI_DAILY_CALLS_PER_STUDENT caps the cost.
OPENAI_API_KEY=
AI_RUNTIME_MODEL=gpt-6-luna
AI_BATCH_MODEL=gpt-6-luna
# How hard the model thinks first: low, medium or high. Leave empty for a model that does not
# reason (gpt-4o), which rejects the setting.
AI_REASONING_EFFORT=low
AI_DAILY_CALLS_PER_STUDENT=20
# Send the reviewed diagram with the question. A coach that cannot see the figure is guessing
# at any step that points into it; it costs more per turn than the text around it.
AI_SEND_FIGURES=true
# The coach speaks the explanation and writes only the summary on the board, the way a teacher
# talks for a minute and writes one line. With AI_SPEAK off the board still fills, but most of
# the lesson — the part that was only ever said — is not delivered.
AI_SPEAK=true
AI_SPEECH_MODEL=gpt-4o-mini-tts
AI_SPEECH_VOICE=marin
# Let the student SPEAK their question instead of typing it. The audio is transcribed and
# immediately dropped — only the words are stored, in tutor_turns, exactly as a typed question
# would be. Set false to run text-only.
AI_LISTEN=true
AI_TRANSCRIPTION_MODEL=gpt-transcribe
